# Development API
PORT=3000
DCIECMS_AUTH_MODE=development

# Secure document pipeline development/testing only.
# In non-production environments, an omitted mode also defaults to development.
# Never use the in-memory storage or scripted scanner adapters as production integrations.
DCIECMS_DOCUMENT_PIPELINE_MODE=development

# PostgreSQL persistence
# Never commit a live credential. Supply this through the local environment or secret manager.
DATABASE_URL=postgresql://dciecms:change-me@localhost:5432/dciecms

# Production OIDC authentication example — placeholder metadata only.
# Never commit live IdP credentials or bearer tokens.
# DCIECMS_AUTH_MODE=oidc
# DCIECMS_OIDC_ISSUER=https://identity.example.gov.pg
# DCIECMS_OIDC_AUDIENCE=dciecms-api
# DCIECMS_OIDC_JWKS_URI=https://identity.example.gov.pg/.well-known/jwks.json
# DCIECMS_OIDC_ALLOWED_ALGS=RS256

# Production secure-document activation is intentionally NOT configured here.
# Production defaults to disabled unless explicitly enabled, and enabled mode requires
# approved injected private/encrypted object-storage and malware-scanner adapters.
# DCIECMS_DOCUMENT_PIPELINE_MODE=enabled
# Storage/scanner credentials, KMS references and provider endpoints belong in an approved secret manager,
# not in this repository or this example file.
